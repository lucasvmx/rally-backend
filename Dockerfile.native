FROM ghcr.io/graalvm/native-image-community:25 AS compilacao
WORKDIR /app
RUN microdnf install -y maven \
    && microdnf clean all
COPY pom.xml .
COPY src src
RUN mvn -B -Pnative -DskipTests native:compile

FROM cgr.dev/chainguard/glibc-dynamic
WORKDIR /app
COPY --from=compilacao /app/target/servico-rally .
EXPOSE 8080
ENTRYPOINT ["/app/servico-rally"]
